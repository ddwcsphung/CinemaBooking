@model CinemaBooking.ViewModels.BookingCreateViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Chọn ghế";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var hasAvailableSeats = Model.Seats.Any(
        s => s.IsActive && !s.IsBooked);
}

<h1 class="mb-3">Chọn ghế</h1>

<section class="card shadow-sm mb-4" aria-labelledby="showtime-title">
    <div class="card-body">
        <h2 id="showtime-title" class="h4 mb-3">@Model.MovieTitle</h2>

        <dl class="row mb-0">
            <dt class="col-sm-3">Phòng</dt>
            <dd class="col-sm-9">@Model.RoomName</dd>

            <dt class="col-sm-3">Suất chiếu</dt>
            <dd class="col-sm-9">
                @Model.StartTime.ToString("HH:mm dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">Giá mỗi ghế</dt>
            <dd class="col-sm-9 mb-0">
                <strong id="unit-price">@Model.BasePrice.ToString("N0", vi) đ</strong>
            </dd>
        </dl>
    </div>
</section>

@if (TempData["BookingError"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<div class="alert alert-info">
    Chọn tối đa 10 ghế. Ghế chỉ được giữ cho bạn sau khi
    xác nhận đặt vé thành công; việc chọn ghế không giữ chỗ.
    Thanh toán tại quầy bằng mã đặt vé.
</div>

<div id="availability-message"
     class="alert alert-warning @(hasAvailableSeats ? "d-none" : "")"
     role="status">
    Suất chiếu hiện không còn ghế có thể đặt.
</div>

<p id="seat-sync-status"
   class="text-muted small"
   role="status">
    Đang kiểm tra trạng thái ghế...
</p>

<form asp-controller="Bookings"
      asp-action="Create"
      method="post"
      id="booking-form"
      data-seats-url="@Url.Content($"~/api/showtimes/{Model.ShowtimeId}/seats")"
      data-selection-url="@Url.Content($"~/api/showtimes/{Model.ShowtimeId}/selection")">

    <input asp-for="ShowtimeId" type="hidden" />

    <p id="selection-status"
       class="text-muted small"
       role="status">
        Đang khôi phục lựa chọn...
    </p>

    <ul class="seat-legend list-unstyled d-flex flex-wrap gap-3 mb-3"
        aria-label="Chú giải trạng thái ghế">
        <li>
            <span class="seat-swatch btn btn-outline-primary" aria-hidden="true">A1</span>
            Ghế trống
        </li>
        <li>
            <span class="seat-swatch btn btn-primary seat-swatch-selected" aria-hidden="true">A1</span>
            Đang chọn (✓)
        </li>
        <li>
            <span class="seat-swatch btn btn-secondary seat-swatch-booked" aria-hidden="true">A1</span>
            Đã đặt (gạch chéo)
        </li>
        <li>
            <span class="seat-swatch btn btn-secondary seat-swatch-inactive" aria-hidden="true">A1</span>
            Ngừng sử dụng (✕)
        </li>
    </ul>

    <div class="screen-bar border rounded bg-light text-center p-2 mb-4">
        MÀN HÌNH
    </div>

    <div class="seat-map overflow-auto mb-4">
        @foreach (var row in Model.Seats.GroupBy(s => s.RowLabel))
        {
            <div class="d-flex align-items-center gap-2 mb-2"
                 style="min-width: max-content;">

                <strong class="seat-row-label me-2">
                    @row.Key
                </strong>

               @foreach (var seat in row.OrderBy(s => s.SeatNumber))
               {
                    var unavailable = !seat.IsActive || seat.IsBooked;
                    var status = seat.IsBooked
                        ? "Đã đặt"
                        : !seat.IsActive
                            ? "Ngừng sử dụng"
                            : "Ghế trống";

                    <input type="checkbox"
                           class="btn-check seat-choice"
                           name="SelectedSeatIds"
                           value="@seat.SeatId"
                           id="seat-@seat.SeatId"
                           data-label="@seat.Label"
                           autocomplete="off"
                           disabled="@unavailable" />

                    <label class="btn seat-label @(unavailable
                                       ? "btn-secondary"
                                       : "btn-outline-primary")"
                           for="seat-@seat.SeatId"
                           title="@status">
                        @seat.Label
                    </label>
                }
            </div>
        }
    </div>

    <p class="small text-muted">
        Di chuột hoặc đưa tiêu điểm vào ghế để xem trạng thái.
        Dùng phím Tab để di chuyển và phím Space để chọn ghế.
    </p>

    <div class="border rounded p-3 mb-3" aria-live="polite">
        <p>
            Ghế đang chọn:
            <strong id="selected-seats">Chưa chọn</strong>
        </p>

        <p class="mb-0">
            Tổng tiền dự kiến:
            <strong id="total-price">0 đ</strong>
        </p>
    </div>

    <p id="seat-error" class="text-danger" role="alert"></p>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit"
                id="submit-booking"
                class="btn btn-primary"
                disabled>
            Xác nhận đặt vé
        </button>

        <a asp-controller="Catalog"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Quay lại danh sách phim
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/js/booking-seats.js"
            asp-append-version="true"></script>
}
