@model CinemaBooking.Models.Room

@{
    ViewData["Title"] = "Thêm phòng chiếu";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Rooms"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="Ví dụ: Phòng 01" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive"
                       class="form-check-input" />
                <label asp-for="IsActive"
                       class="form-check-label"></label>
            </div>

            <p class="text-muted">
                Sau khi thêm phòng, vào Quản lý ghế để tạo ghế
                trước khi lập lịch chiếu.
            </p>

            <button type="submit" class="btn btn-primary">
                Thêm phòng
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Quay lại
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}