@{
    var currentController =
        ViewContext.RouteData.Values["controller"] as string;
    var currentArea =
        ViewContext.RouteData.Values["area"] as string;

    string NavClass(string controller) =>
        string.IsNullOrEmpty(currentArea) && currentController == controller
            ? "nav-link active fw-semibold"
            : "nav-link text-dark";

    var adminControllers = new[]
    {
        "AdminBookings", "Movies", "Genres", "Rooms", "Seats", "Showtimes"
    };
    var inAdmin = string.IsNullOrEmpty(currentArea)
        && adminControllers.Contains(currentController);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CinemaBooking</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CinemaBooking.styles.css"
          asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable skip-link" href="#main-content">
        Bỏ qua tới nội dung chính
    </a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Catalog"
                   asp-action="Index">
                    CinemaBooking
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mở hoặc đóng menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="@NavClass("Catalog")"
                               aria-current="@(currentController == "Catalog" ? "page" : null)"
                               asp-area=""
                               asp-controller="Catalog"
                               asp-action="Index">
                                Phim đang chiếu
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Bookings")"
                                   aria-current="@(currentController == "Bookings" ? "page" : null)"
                                   asp-area=""
                                   asp-controller="Bookings"
                                   asp-action="Index">
                                    Vé của tôi
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(inAdmin ? "active fw-semibold" : "text-dark")"
                                   href="#"
                                   id="adminMenu"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Quản trị
                                </a>

                                <ul class="dropdown-menu"
                                    aria-labelledby="adminMenu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="AdminBookings"
                                           asp-action="Index">
                                            Quản lý đơn đặt vé
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>
                                    
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Movies"
                                           asp-action="Index">
                                            Quản lý phim
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Genres"
                                           asp-action="Index">
                                            Quản lý thể loại
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Rooms"
                                           asp-action="Index">
                                            Quản lý phòng và ghế
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Showtimes"
                                           asp-action="Index">
                                            Quản lý suất chiếu
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" id="main-content" class="pb-4" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto">
        <div class="container d-flex flex-wrap gap-2 align-items-center">
            <span>&copy; @DateTime.Now.Year CinemaBooking</span>
            <span aria-hidden="true">·</span>
            <span>Đặt vé trực tuyến, thanh toán tại quầy</span>
            <span aria-hidden="true">·</span>
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Thông tin riêng tư
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>