@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="text-danger h2 mb-3">Đã xảy ra lỗi</h1>

        <p class="lead">
            Hệ thống không thể xử lý yêu cầu của bạn lúc này.
            Vui lòng thử lại sau ít phút.
        </p>

        <p>
            Nếu bạn vừa gửi đặt vé hoặc thao tác quản trị, hãy kiểm tra lại
            trạng thái thực tế (ví dụ trong "Vé của tôi") trước khi gửi lại
            để tránh thao tác trùng.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted">
                Mã yêu cầu (gửi kèm khi báo lỗi):
                <code class="text-break">@Model.RequestId</code>
            </p>
        }

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-area=""
               asp-controller="Catalog"
               asp-action="Index"
               class="btn btn-primary">
                Về danh sách phim
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area=""
                   asp-controller="Bookings"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Vé của tôi
                </a>
            }
        </div>
    </div>
</div>
