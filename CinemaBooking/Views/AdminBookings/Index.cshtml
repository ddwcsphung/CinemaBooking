@model IEnumerable<CinemaBooking.Models.Booking>
@using CinemaBooking.Models
@using System.Globalization

@{
    ViewData["Title"] = "Quản lý đơn đặt vé";

    var vi = CultureInfo.GetCultureInfo("vi-VN");

    string? keyword = ViewBag.Keyword;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
}

<h1 class="mb-4">@ViewData["Title"]</h1>

@if (TempData["AdminBookingSuccess"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (TempData["AdminBookingError"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (TempData["AdminBookingInfo"] is string info)
{
    <div class="alert alert-info" role="alert">
        @info
    </div>
}

<form asp-controller="AdminBookings"
      asp-action="Index"
      method="get"
      class="row g-3 align-items-end mb-4">

    <div class="col-md-8">
        <label for="keyword" class="form-label">
            Mã đặt vé
        </label>

        <input id="keyword"
               name="keyword"
               value="@keyword"
               class="form-control"
               placeholder="Nhập toàn bộ hoặc một phần mã đặt vé..." />
    </div>

    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

        <a asp-controller="AdminBookings"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Xóa bộ lọc
        </a>
    </div>
</form>

<p class="text-muted">
    Tìm thấy @totalItems đơn đặt vé.
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Không có đơn đặt vé phù hợp.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var booking in Model)
        {
            var seatNames = booking.BookingSeats
                .OrderBy(bs => bs.Seat.RowLabel)
                .ThenBy(bs => bs.Seat.SeatNumber)
                .Select(bs =>
                    $"{bs.Seat.RowLabel}{bs.Seat.SeatNumber}");

            <div class="col-12">
                <article class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-wrap
                                    justify-content-between
                                    align-items-start gap-2 mb-3">
                            <h2 class="h5 mb-0">
                                @booking.Showtime.Movie.Title
                            </h2>

                            @if (booking.PaymentStatus ==
                                 BookingPaymentStatus.Paid)
                            {
                                <span class="badge bg-success">
                                    Đã thanh toán
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Chưa thanh toán
                                </span>
                            }
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-3">Mã đặt vé</dt>
                            <dd class="col-sm-9 text-break">
                                @booking.BookingCode
                            </dd>

                            <dt class="col-sm-3">Khách hàng</dt>
                            <dd class="col-sm-9 text-break">
                                @(booking.User.Email
                                    ?? booking.User.UserName)
                            </dd>

                            <dt class="col-sm-3">Phòng</dt>
                            <dd class="col-sm-9">
                                @booking.Showtime.Room.Name
                            </dd>

                            <dt class="col-sm-3">Suất chiếu</dt>
                            <dd class="col-sm-9">
                                @booking.Showtime.StartTime.ToString(
                                    "HH:mm dd/MM/yyyy")
                            </dd>

                            <dt class="col-sm-3">Ghế</dt>
                            <dd class="col-sm-9">
                                @string.Join(", ", seatNames)
                            </dd>

                            <dt class="col-sm-3">Thời điểm đặt</dt>
                            <dd class="col-sm-9">
                                @(booking.CreatedAtUtc
                                    .ToOffset(TimeSpan.FromHours(7))
                                    .ToString("HH:mm dd/MM/yyyy"))
                            </dd>

                            <dt class="col-sm-3">Tổng tiền</dt>
                            <dd class="col-sm-9">
                                <strong>
                                    @booking.TotalAmount.ToString("N0", vi) đ
                                </strong>
                            </dd>
                        </dl>

                        @if (booking.PaymentStatus ==
                             BookingPaymentStatus.Unpaid)
                        {
                            <form asp-controller="AdminBookings"
                                  asp-action="ConfirmPayment"
                                  asp-route-id="@booking.Id"
                                  method="post"
                                  class="mt-3"
                                  onsubmit="return confirm('Bạn xác nhận đã thu đủ tiền cho đơn này tại quầy?');">

                                <input type="hidden"
                                       name="keyword"
                                       value="@keyword" />

                                <input type="hidden"
                                       name="page"
                                       value="@currentPage" />

                                <button type="submit"
                                        class="btn btn-success">
                                    Xác nhận đã thu tiền
                                </button>
                            </form>
                        }
                    </div>
                </article>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Phân trang đơn đặt vé" class="mt-4">
            <ul class="pagination justify-content-center">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-page="@(currentPage - 1)">
                            Trước
                        </a>
                    </li>
                }

                <li class="page-item disabled">
                    <span class="page-link">
                        Trang @currentPage / @totalPages
                    </span>
                </li>

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-page="@(currentPage + 1)">
                            Sau
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
