@model CinemaBooking.ViewModels.MovieCatalogViewModel

@{
    ViewData["Title"] = "Khám phá phim";

    var firstPage = Math.Max(1, Model.Page - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Keyword)
        || Model.GenreId.HasValue;
}

<h1 class="mb-4">Khám phá phim</h1>

<form asp-controller="Catalog"
      asp-action="Index"
      method="get"
      class="row g-3 mb-4">

    <div class="col-md-6">
        <label asp-for="Keyword" class="form-label">
            Tên phim
        </label>

        <input asp-for="Keyword"
               type="search"
               class="form-control"
               placeholder="Nhập tên phim..." />
    </div>

    <div class="col-md-4">
        <label asp-for="GenreId" class="form-label">
            Thể loại
        </label>

        <select asp-for="GenreId"
                asp-items="Model.GenreOptions"
                class="form-select">
            <option value="">Tất cả thể loại</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            Tìm kiếm
        </button>
    </div>
</form>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <span role="status">Tìm thấy @Model.TotalItems phim</span>

    @if (hasFilter)
    {
        <a asp-controller="Catalog"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">
            Xóa bộ lọc
        </a>
    }
</div>

@if (Model.Movies.Count == 0)
{
    <div class="alert alert-info" role="status">
        @if (hasFilter)
        {
            <p class="mb-2">
                Không có phim phù hợp với bộ lọc hiện tại.
                Bạn hãy thử từ khóa hoặc thể loại khác.
            </p>
            <a asp-controller="Catalog"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                Xem tất cả phim
            </a>
        }
        else
        {
            <span>Hiện chưa có phim nào đang chiếu. Vui lòng quay lại sau.</span>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var movie in Model.Movies)
        {
            <div class="col">
                <article class="card h-100 shadow-sm">
                    <partial name="_Poster"
                             model="movie"
                             view-data='new ViewDataDictionary(ViewData) { { "PosterClass", "card-img-top poster poster-card" } }' />

                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@movie.Title</h2>

                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var genre in movie.Genres.OrderBy(g => g.Name))
                            {
                                <span class="badge text-bg-light border">@genre.Name</span>
                            }
                        </div>

                        <p class="mb-1">
                            Thời lượng: @movie.DurationMinutes phút
                        </p>

                        <p class="mb-3">
                            Khởi chiếu:
                            @movie.ReleaseDate.ToString("dd/MM/yyyy")
                        </p>

                        <a asp-controller="Catalog"
                           asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="btn btn-primary mt-auto">
                            Chi tiết và lịch chiếu
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang phim" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                @if (Model.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-genreId="@Model.GenreId">
                            Trước
                        </a>
                    </li>
                }

                @for (var p = firstPage; p <= lastPage; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")"
                        aria-current="@(p == Model.Page ? "page" : null)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@p"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-genreId="@Model.GenreId">
                            @p
                        </a>
                    </li>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-genreId="@Model.GenreId">
                            Sau
                        </a>
                    </li>
                }
            </ul>

            <p class="text-center text-muted">
                Trang @Model.Page / @Model.TotalPages
            </p>
        </nav>
    }
}