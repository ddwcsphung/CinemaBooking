@model CinemaBooking.ViewModels.MovieCatalogViewModel

@{
    ViewData["Title"] = "Khám phá phim";

    var firstPage = Math.Max(1, Model.Page - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<h1 class="mb-4">Khám phá phim</h1>

<form asp-controller="Catalog"
      asp-action="Index"
      method="get"
      class="row g-3 mb-4">

    <div class="col-md-6">
        <label asp-for="Keyword" class="form-label">
            Tên phim
        </label>

        <input asp-for="Keyword"
               class="form-control"
               placeholder="Nhập tên phim..." />
    </div>

    <div class="col-md-4">
        <label asp-for="GenreId" class="form-label">
            Thể loại
        </label>

        <select asp-for="GenreId"
                asp-items="Model.GenreOptions"
                class="form-select">
            <option value="">Tất cả thể loại</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            Tìm kiếm
        </button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span>Tìm thấy @Model.TotalItems phim</span>

    <a asp-controller="Catalog"
       asp-action="Index"
       class="btn btn-outline-secondary btn-sm">
        Xóa bộ lọc
    </a>
</div>

@if (Model.Movies.Count == 0)
{
    <div class="alert alert-info">
        Không có phim phù hợp. Bạn hãy thử từ khóa hoặc thể loại khác.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var movie in Model.Movies)
        {
            <div class="col">
                <article class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                    {
                        <img src="@movie.PosterUrl"
                             alt="Poster @movie.Title"
                             class="card-img-top"
                             loading="lazy"
                             style="height: 320px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center
                            justify-content-center text-secondary"
                             style="height: 320px;">
                            Chưa có poster
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@movie.Title</h2>

                        <p class="text-muted small mb-2">
                            @string.Join(", ", movie.Genres.Select(g => g.Name))
                        </p>

                        <p class="mb-1">
                            Thời lượng: @movie.DurationMinutes phút
                        </p>

                        <p class="mb-3">
                            Khởi chiếu:
                            @movie.ReleaseDate.ToString("dd/MM/yyyy")
                        </p>

                        <a asp-controller="Catalog"
                           asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="btn btn-primary mt-auto">
                            Chi tiết và lịch chiếu
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang phim" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                @if (Model.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-genreId="@Model.GenreId">
                            Trước
                        </a>
                    </li>
                }

                @for (var p = firstPage; p <= lastPage; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@p"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-genreId="@Model.GenreId">
                            @p
                        </a>
                    </li>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-genreId="@Model.GenreId">
                            Sau
                        </a>
                    </li>
                }
            </ul>

            <p class="text-center text-muted">
                Trang @Model.Page / @Model.TotalPages
            </p>
        </nav>
    }
}