@model CinemaBooking.Models.Genre

@{
    ViewData["Title"] = "Xóa thể loại";
}

<h1 class="mb-3">Xóa thể loại</h1>

<div asp-validation-summary="All"
     class="text-danger mb-3"
     role="alert"></div>

<p>
    Bạn có chắc muốn xóa thể loại
    <strong>@Model.Name</strong> không?
</p>

<p class="text-muted">
    Chỉ xóa được thể loại không còn được phim nào sử dụng.
</p>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      class="d-flex flex-wrap gap-2">

    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Xác nhận xóa
    </button>

    <a asp-controller="Movies"
       asp-action="Index"
       class="btn btn-outline-primary">
        Quản lý phim
    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Quay lại
    </a>
</form>