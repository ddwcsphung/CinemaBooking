@model IEnumerable<CinemaBooking.Models.Movie>

@{
    ViewData["Title"] = "Quản lý phim";
}

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-2 mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    <a asp-action="Create" class="btn btn-primary">
        Thêm phim
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Chưa có phim nào. Hãy tạo thể loại trước, sau đó thêm phim.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Tên phim</th>
                    <th scope="col">Thời lượng</th>
                    <th scope="col">Ngày khởi chiếu</th>
                    <th scope="col">Hiển thị</th>
                    <th scope="col">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model)
                {
                    <tr>
                        <td>@movie.Title</td>
                        <td class="text-nowrap">@movie.DurationMinutes phút</td>
                        <td class="text-nowrap">@movie.ReleaseDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (movie.IsActive)
                            {
                                <span class="badge bg-success">Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đang ẩn</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Chi tiết
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Sửa
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
