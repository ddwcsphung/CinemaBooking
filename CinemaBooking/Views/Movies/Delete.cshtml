@model CinemaBooking.Models.Movie

@{
    ViewData["Title"] = "Xóa phim";
}

<h1 class="mb-3">Xóa phim</h1>

<p>
    Bạn có chắc muốn xóa phim
    <strong>@Model.Title</strong> không?
</p>

<div asp-validation-summary="All"
     class="text-danger mb-3"
     role="alert"></div>

<dl class="row">
    <dt class="col-sm-3">Tên phim</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Thời lượng</dt>
    <dd class="col-sm-9">@Model.DurationMinutes phút</dd>

    <dt class="col-sm-3">Khởi chiếu</dt>
    <dd class="col-sm-9">
        @Model.ReleaseDate.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-3">Thể loại</dt>
    <dd class="col-sm-9">
        @string.Join(", ", Model.Genres.Select(g => g.Name))
    </dd>
</dl>

<p class="text-muted">
    Phim đã có lịch chiếu không được xóa.
    Bạn có thể tắt hiển thị phim tại trang Sửa.
</p>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post"
      class="d-flex flex-wrap gap-2">

    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Xác nhận xóa
    </button>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary">
        Sửa phim
    </a>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Quay lại
    </a>
</form>