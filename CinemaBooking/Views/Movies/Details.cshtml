@model CinemaBooking.Models.Movie

@{
    ViewData["Title"] = "Chi tiết phim";
}

<h1 class="mb-4">Chi tiết phim</h1>

<div class="row g-4">
    <div class="col-md-4">
        <partial name="_Poster"
                 model="Model"
                 view-data='new ViewDataDictionary(ViewData) { { "PosterClass", "poster poster-detail rounded shadow-sm" } }' />
    </div>

    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Tên phim</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Nội dung</dt>
            <dd class="col-sm-9 text-pre-line">@Model.Description</dd>

            <dt class="col-sm-3">Thời lượng</dt>
            <dd class="col-sm-9">
                @Model.DurationMinutes phút
            </dd>

            <dt class="col-sm-3">Ngày khởi chiếu</dt>
            <dd class="col-sm-9">
                @Model.ReleaseDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">Thể loại</dt>
            <dd class="col-sm-9">
                @if (Model.Genres.Any())
                {
                    @string.Join(", ", Model.Genres
                        .OrderBy(g => g.Name)
                        .Select(g => g.Name))
                }
                else
                {
                    <span class="text-muted">Chưa có thể loại</span>
                }
            </dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Đang hiển thị
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Đang ẩn
                    </span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    <a asp-controller="Movies"
       asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Sửa phim
    </a>

    <a asp-controller="Movies"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Quay lại danh sách
    </a>
</div>
